<Window x:Class="doan.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:doan.Views"
        mc:Ignorable="d"
        Title="Đăng Nhập Hệ Thống" Height="450" Width="750"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="16" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1.5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột bên trái: Gradient và Logo Sân bóng -->
            <Border CornerRadius="15,0,0,15" Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#059669" Offset="0.0"/>
                        <GradientStop Color="#10B981" Offset="0.5"/>
                        <GradientStop Color="#06B6D4" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Icon Sân bóng vẽ bằng Vector Path -->
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A1.5,1.5 0 0,1 13.5,5.5A1.5,1.5 0 0,1 12,7A1.5,1.5 0 0,1 10.5,5.5A1.5,1.5 0 0,1 12,4M7.5,8A1.5,1.5 0 0,1 9,9.5A1.5,1.5 0 0,1 7.5,11A1.5,1.5 0 0,1 6,9.5A1.5,1.5 0 0,1 7.5,8M16.5,8A1.5,1.5 0 0,1 18,9.5A1.5,1.5 0 0,1 16.5,11A1.5,1.5 0 0,1 15,9.5A1.5,1.5 0 0,1 16.5,8M12,10.5A1.5,1.5 0 0,1 13.5,12A1.5,1.5 0 0,1 12,13.5A1.5,1.5 0 0,1 10.5,12A1.5,1.5 0 0,1 12,10.5M7.5,13A1.5,1.5 0 0,1 9,14.5A1.5,1.5 0 0,1 7.5,16A1.5,1.5 0 0,1 6,14.5A1.5,1.5 0 0,1 7.5,13M16.5,13A1.5,1.5 0 0,1 18,14.5A1.5,1.5 0 0,1 16.5,16A1.5,1.5 0 0,1 15,14.5A1.5,1.5 0 0,1 16.5,13M12,16.5A1.5,1.5 0 0,1 13.5,18A1.5,1.5 0 0,1 12,19.5A1.5,1.5 0 0,1 10.5,18A1.5,1.5 0 0,1 12,16.5Z" 
                              Fill="White" Stretch="Uniform" Width="80" Height="80" HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="PITCH MASTER" FontFamily="Segoe UI" FontWeight="Bold" FontSize="26" Foreground="White" Margin="0,15,0,5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hệ Thống Quản Lý Sân Bóng Mini" FontFamily="Segoe UI" FontSize="13" Foreground="#E0F2FE" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="HUIT .NET Project © 2026" FontSize="11" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
                </Grid>
            </Border>

            <!-- Cột bên phải: Form đăng nhập -->
            <Grid Grid.Column="1" Margin="30,20,30,20">
                <!-- Nút Đóng & Thu nhỏ cửa sổ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="‒" Width="30" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="btnMinimize_Click" Style="{StaticResource ModernButton}"/>
                    <Button Content="✕" Width="30" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="btnClose_Click" Style="{StaticResource DangerButton}" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Margin="10,20,10,0">
                    <TextBlock Text="Chào Mừng Trở Lại" FontFamily="Segoe UI" FontWeight="Bold" FontSize="24" Foreground="White" Margin="0,0,0,5"/>
                    <TextBlock Text="Vui lòng đăng nhập tài khoản của bạn để tiếp tục" FontFamily="Segoe UI" FontSize="13" Foreground="#64748B" Margin="0,0,0,25"/>

                    <!-- Tên đăng nhập -->
                    <TextBlock Text="Tên đăng nhập" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBox}" Background="#1E293B" Foreground="White" BorderBrush="#334155" FontSize="14" Margin="0,0,0,15" KeyDown="Input_KeyDown"/>

                    <!-- Mật khẩu -->
                    <TextBlock Text="Mật khẩu" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}" Background="#1E293B" Foreground="White" BorderBrush="#334155" FontSize="14" Margin="0,0,0,10" KeyDown="Input_KeyDown"/>

                    <!-- Lỗi Validation hiển thị ở đây -->
                    <TextBlock x:Name="lblError" Text="" Foreground="#EF4444" FontSize="12" Margin="0,5,0,15" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- Nút đăng nhập -->
                    <Button Content="ĐĂNG NHẬP" Style="{StaticResource ModernButton}" Height="42" Margin="0,5,0,0" Click="btnLogin_Click" FontSize="14" FontWeight="Bold"/>

                    <TextBlock Text="Mặc định: admin / admin123 (Admin) | nhanvien / staff123 (Nhân viên)" Foreground="#475569" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
