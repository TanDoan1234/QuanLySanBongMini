<Window x:Class="doan.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:doan.Views"
        mc:Ignorable="d"
        Title="Đăng Nhập Hệ Thống" Height="580" Width="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border CornerRadius="20" BorderThickness="1.5" BorderBrush="#E2E8F0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ECF2FF" Offset="0.0"/>
                <GradientStop Color="#F0F4F8" Offset="0.5"/>
                <GradientStop Color="#E6EEF8" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- Logo Glacier Pitch nhỏ ở góc trên bên trái -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,22,0,0">
                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A1.5,1.5 0 0,1 13.5,5.5A1.5,1.5 0 0,1 12,7A1.5,1.5 0 0,1 10.5,5.5A1.5,1.5 0 0,1 12,4" 
                      Fill="#1E4E79" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Glacier Pitch" FontFamily="{StaticResource MainFont}" FontWeight="Bold" FontSize="14" Foreground="#1E4E79" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Nút Close/Minimize ở góc trên bên phải -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0">
                <!-- Nút Thu nhỏ -->
                <Button x:Name="btnMinimize" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnMinimize_Click" ToolTip="Thu nhỏ">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="15">
                                <TextBlock Text="‒" Foreground="#64748B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Nút Thoát -->
                <Button x:Name="btnClose" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnClose_Click" Margin="5,0,0,0" ToolTip="Đóng">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="15">
                                <TextBlock x:Name="txt" Text="✕" Foreground="#64748B" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Card Đăng nhập ở giữa -->
            <Border CornerRadius="16" Background="White" Margin="30,75,30,35" VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.06" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                
                <Grid Margin="25,25,25,15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome Back" FontFamily="{StaticResource MainFont}" FontWeight="Bold" FontSize="26" Foreground="#1E4E79" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="Đăng nhập để quản lý sân bóng của bạn" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                        <!-- Tên đăng nhập -->
                        <TextBlock Text="Tên đăng nhập" Foreground="#1E4E79" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBox}" Background="#F8FAFC" BorderBrush="#E2E8F0" Foreground="#0F172A" FontSize="14" Padding="35,10,10,10" KeyDown="Input_KeyDown"/>
                            <!-- Icon User -->
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Fill="#64748B" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Mật khẩu -->
                        <TextBlock Text="Mật khẩu" Foreground="#1E4E79" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,15">
                            <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}" Background="#F8FAFC" BorderBrush="#E2E8F0" Foreground="#0F172A" FontSize="14" Padding="35,10,10,10" KeyDown="Input_KeyDown"/>
                            <!-- Icon Lock -->
                            <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" 
                                  Fill="#64748B" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Lỗi Validation -->
                        <TextBlock x:Name="lblError" Text="" Foreground="#EF4444" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center"/>

                        <!-- Nút đăng nhập -->
                        <Button x:Name="btnLogin" Style="{StaticResource ModernButton}" Height="45" Margin="0,5,0,0" Click="btnLogin_Click" Cursor="Hand" Background="#1E4E79">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Đăng Nhập" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    <Path Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- Dữ liệu mẫu -->
                        <TextBlock Text="Mặc định: admin / admin123 (Admin)&#x0a;nhanvien / staff123 (Nhân viên)" Foreground="#94A3B8" FontSize="10" LineHeight="14" HorizontalAlignment="Center" Margin="0,20,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
