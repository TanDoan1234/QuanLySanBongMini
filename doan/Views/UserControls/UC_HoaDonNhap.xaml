<UserControl x:Class="doan.Views.UserControls.UC_HoaDonNhap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:doan.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900" Background="#F1F5F9">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <!-- Bên trái: Tạo hoá đơn nhập -->
            <ColumnDefinition Width="380"/>
            <!-- Khoảng cách -->
            <ColumnDefinition Width="15"/>
            <!-- Bên phải: Chi tiết hoá đơn tạm thời -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- KHU VỰC NHẬP THÔNG TIN SẢN PHẨM CẦN NHẬP -->
        <Border Grid.Column="0" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.03" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Lập Hóa Đơn Nhập" FontSize="18" FontWeight="Bold" Foreground="#1E4E79" Margin="0,0,0,4"/>
                    <TextBlock Text="Nhập thêm hàng hóa, nước uống vào kho" FontSize="12" Foreground="#64748B"/>
                    <Separator Height="1" Background="#E2E8F0" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Các trường nhập chi tiết mặt hàng -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ModernScrollViewer}">
                    <StackPanel Margin="0,5">
                        <!-- Chọn sản phẩm -->
                        <TextBlock Text="Chọn sản phẩm *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboProducts" Style="{StaticResource ModernComboBox}" Height="38" Margin="0,0,0,15" DisplayMemberPath="TenSanPham" SelectedValuePath="MaSanPham"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Số lượng nhập -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số lượng nhập *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtImportQty" Style="{StaticResource ModernTextBox}" Height="38" Text="1" Background="#F8FAFC"/>
                            </StackPanel>

                            <!-- Đơn giá nhập -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Đơn giá nhập (đ) *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtImportPrice" Style="{StaticResource ModernTextBox}" Height="38" Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="btnAddToInvoice" Content="Thêm Vào Hóa Đơn" Style="{StaticResource SecondaryButton}" Height="38" Click="btnAddToInvoice_Click" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Xác nhận lưu hóa đơn -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Height="1" Background="#E2E8F0" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Tổng tiền thanh toán:" FontSize="13.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblTotalAmount" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button x:Name="btnSaveImportInvoice" Content="XÁC NHẬN NHẬP HÀNG" Style="{StaticResource ModernButton}" Height="42" Click="btnSaveImportInvoice_Click" Background="#1E4E79"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BẢNG CHI TIẾT HOÁ ĐƠN NHẬP TẠM THỜI -->
        <Border Grid.Column="2" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.03" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Chi Tiết Nhập Hàng" FontSize="18" FontWeight="Bold" Foreground="#1E4E79" Margin="0,0,0,4"/>
                    <TextBlock Text="Danh sách các mặt hàng đang chờ xác nhận nhập kho" FontSize="12" Foreground="#64748B"/>
                    <Separator Height="1" Background="#E2E8F0" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- DataGrid hiển thị chi tiết hóa đơn tạm thời -->
                <DataGrid x:Name="dgImportDetails" Grid.Row="1" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenSanPham}" Width="*"/>
                        <DataGridTextColumn Header="Đơn giá nhập" Binding="{Binding DonGiaNhap, StringFormat={}{0:#,##0} VNĐ}" Width="120"/>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="90"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:#,##0} VNĐ}" Width="130"/>
                        <!-- Nút Xóa dòng -->
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Xóa" Style="{StaticResource DangerButton}" Padding="10,0" Height="26" Click="btnRemoveDetail_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
