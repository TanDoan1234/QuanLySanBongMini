<UserControl x:Class="doan.Views.UserControls.UC_ThongKe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:doan.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000" Background="#F8FAFC">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Bộ lọc và Xuất báo cáo -->
            <RowDefinition Height="Auto"/>
            <!-- Các thẻ tóm tắt (KPI cards) -->
            <RowDefinition Height="Auto"/>
            <!-- Dữ liệu chi tiết / Gom nhóm -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BỘ LỌC KHOẢNG THỜI GIAN -->
        <Border Grid.Row="0" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Từ ngày:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="dpFromDate" Width="150" Height="36" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <TextBlock Text="Đến ngày:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="dpToDate" Width="150" Height="36" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <Button Content="Thống Kê" Style="{StaticResource ModernButton}" Height="36" Padding="25,0" Click="btnFilter_Click"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Xuất Báo Cáo Excel" Style="{StaticResource SecondaryButton}" Height="36" Padding="20,0" Click="btnExportExcel_Click"/>
            </Grid>
        </Border>

        <!-- CÁC THẺ KPI CỦA BÁO CÁO (TỔNG KẾT) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng doanh thu -->
            <Border Grid.Column="0" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="TỔNG DOANH THU" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBlock x:Name="lblTotalRevenue" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Tiền sân -->
            <Border Grid.Column="2" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="DOANH THU THUÊ SÂN" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBlock x:Name="lblPitchRevenue" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Tiền dịch vụ -->
            <Border Grid.Column="4" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="DOANH THU DỊCH VỤ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBlock x:Name="lblServiceRevenue" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="#6366F1"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Tổng lượt đặt -->
            <Border Grid.Column="6" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="TỔNG LƯỢT ĐẶT SÂN" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBlock x:Name="lblTotalBookings" Text="0 lượt" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- KHU VỰC DỮ LIỆU TAB TIỆN ÍCH -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0">
            <!-- Tab 1: Danh sách hóa đơn chi tiết -->
            <TabItem Header="Danh Sách Hóa Đơn Chi Tiết" Padding="15,8">
                <Border CornerRadius="0,0,12,12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
                    <Grid>
                        <DataGrid x:Name="dgInvoices" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã HD" Binding="{Binding MaHoaDon, StringFormat={}{0:D5}}" Width="70"/>
                                <DataGridTextColumn Header="Ngày thanh toán" Binding="{Binding NgayThanhToan, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                                <DataGridTextColumn Header="Khách hàng" Binding="{Binding PhieuDatSan.KhachHang.TenKhachHang}" Width="*"/>
                                <DataGridTextColumn Header="Sân bóng" Binding="{Binding PhieuDatSan.SanBong.TenSan}" Width="110"/>
                                <DataGridTextColumn Header="Tiền sân" Binding="{Binding TienSan, StringFormat={}{0:#,##0} VNĐ}" Width="110"/>
                                <DataGridTextColumn Header="Tiền DV" Binding="{Binding TienDichVu, StringFormat={}{0:#,##0} VNĐ}" Width="110"/>
                                <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TongTien, StringFormat={}{0:#,##0} VNĐ}" Width="130"/>
                                <DataGridTemplateColumn Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Xem in" Style="{StaticResource SecondaryButton}" Height="24" Padding="5,0" Click="btnViewInvoicePrint_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: Thống kê nâng cao (Gom nhóm - Yêu cầu STT 10) -->
            <TabItem Header="Báo Cáo Phân Tích &amp; Gom Nhóm" Padding="15,8">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Gom nhóm theo Sân bóng -->
                    <Border Grid.Column="0" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Doanh Thu Theo Sân Bóng" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Gom nhóm tổng hợp lượt đá và doanh thu từng sân" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <DataGrid x:Name="dgGroupedPitches" Grid.Row="1" Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sân bóng" Binding="{Binding TenSan}" Width="*"/>
                                    <DataGridTextColumn Header="Số lượt đá" Binding="{Binding LuotDa}" Width="90"/>
                                    <DataGridTextColumn Header="Doanh thu sân" Binding="{Binding DoanhThu, StringFormat={}{0:#,##0} VNĐ}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Cột phải: Gom nhóm theo Sản phẩm / Dịch vụ bán chạy -->
                    <Border Grid.Column="2" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Dịch Vụ &amp; Sản Phẩm Tiêu Thụ" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,2"/>
                                <TextBlock Text="Gom nhóm tổng hợp sản lượng sản phẩm dịch vụ đã bán" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <DataGrid x:Name="dgGroupedProducts" Grid.Row="1" Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sản phẩm / Dịch vụ" Binding="{Binding TenSanPham}" Width="*"/>
                                    <DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="80"/>
                                    <DataGridTextColumn Header="Số lượng bán" Binding="{Binding SoLuongBan}" Width="100"/>
                                    <DataGridTextColumn Header="Tổng tiền thu" Binding="{Binding DoanhThu, StringFormat={}{0:#,##0} VNĐ}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
